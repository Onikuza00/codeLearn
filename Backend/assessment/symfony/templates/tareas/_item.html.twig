    <li>{{tarea.title}} -> {{tarea.createdAt|date('d/m/Y')}}</li>
    <form method="post" action="{{ path('tarea_borrada', {id: tarea.id}) }}">
        <button type="submit">Borrar</button>
    </form>
        {% if tarea.done %}
        <p>✅ Hecha</p>
        {% else %}
        <p>⏳ Pendiente</p>
        {% endif %}

